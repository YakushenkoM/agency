---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';

const contactLink = `mailto:${siteConfig.brand.email}`;
const bookingLink = siteConfig.brand.bookingUrl;
---

<Layout
  title="Recruitment for Startups & Scaleups | The Dreamers Talent"
  description="Recruitment for impact-driven companies. We help founders and hiring managers fill critical roles fast, with direct access and clear search progress."
>

  <!-- Full-bleed blue hero with a soft pink glow. -->
  <div class="hero-band">
    <div class="hero-main-frame">
      <div class="hero-inner">
        <div class="eyebrow">
          <span class="eyebrow-content">Recruitment for impact-driven companies</span>
          <span class="eyebrow-border-rotation" aria-hidden="true"></span>
        </div>
        <h1>Building the teams that turn dreams into products</h1>
        <p>We work directly with founders and hiring managers to understand the role and bring the right people into the conversation.</p>
        <div class="hero-actions">
          <a class="cta" href={bookingLink} target="_blank" rel="noopener noreferrer">Book a call</a>
          <a class="cta ghost" href="#pricing">See pricing</a>
        </div>
      </div>
    </div>
    <div class="hero-stats">
      <div class="stats">
        <div class="stat" data-card="01"><span class="big">91%</span><span class="label">offer acceptance rate</span></div>
        <div class="stat" data-card="02"><span class="big">96%</span><span class="label">successful hires</span></div>
        <div class="stat" data-card="03"><span class="big">3–5 days</span><span class="label">average shortlist time</span></div>
      </div>
    </div>
  </div>

  <div class="wrap">

    <div class="journey-band">
    <section class="roles" id="roles">
      <div class="section-label">Who we recruit</div>
      <h2 class="roles-title">Technical roles, found with care</h2>
      <p class="roles-sub">Specialist recruitment across engineering, data, AI, infrastructure and design.</p>
      <div class="roles-grid">
        <article class="role-card" data-card="01"><h3>Backend</h3><span class="role-stack">.NET · Java · PHP · Python</span><ul><li>Backend Developer</li><li>Tech Lead</li><li>Software Architect</li></ul></article>
        <article class="role-card" data-card="02"><h3>Frontend</h3><span class="role-stack">JavaScript · TypeScript</span><ul><li>Frontend Developer</li><li>Full-stack Developer</li><li>React Engineer</li></ul></article>
        <article class="role-card" data-card="03"><h3>Mobile</h3><span class="role-stack">Android · iOS · cross-platform</span><ul><li>Android Developer</li><li>iOS Developer</li><li>React Native / Flutter Developer</li></ul></article>
        <article class="role-card" data-card="04"><h3>Data engineering</h3><span class="role-stack">Pipelines · warehouses · analytics</span><ul><li>Data Engineer</li><li>Analytics Engineer</li><li>Big Data Engineer</li></ul></article>
        <article class="role-card" data-card="05"><h3>AI &amp; Machine Learning</h3><span class="role-stack">Models · LLMs · MLOps</span><ul><li>Machine Learning Engineer</li><li>AI / LLM Engineer</li><li>Data Scientist</li></ul></article>
        <article class="role-card" data-card="06"><h3>DevOps</h3><span class="role-stack">Cloud · infrastructure · reliability</span><ul><li>DevOps Engineer</li><li>Site Reliability Engineer</li><li>Cloud Engineer</li></ul></article>
        <article class="role-card" data-card="07"><h3>Niche roles</h3><span class="role-stack">Hard-to-find · confidential searches</span><ul><li>Embedded C/C++ Engineer</li><li>Systems / Firmware Engineer</li><li>Security Engineer</li></ul></article>
        <article class="role-card" data-card="08"><h3>UX/UI design</h3><span class="role-stack">Product design</span><ul><li>Product Designer</li><li>UX Designer</li><li>UI Designer</li></ul></article>
      </div>

      <div class="reach-grid">
        <div class="reach-panel">
          <h3>Locations</h3>
          <p>Remote-first hiring across:</p>
          <div class="chips"><span>Europe</span><span>United States</span><span>LATAM</span><span>Ukraine</span><span>Canada</span></div>
          <p class="reach-note">Hiring for a team in another time zone? We can help you find the right people, wherever they are.</p>
        </div>
        <div class="reach-panel">
          <h3>Industries</h3>
          <p>Companies building products that matter:</p>
          <div class="chips"><span>Robotics</span><span>Healthcare &amp; MedTech</span><span>Climate &amp; sustainability</span><span>AI products</span><span>SaaS</span><span>Fintech</span></div>
        </div>
      </div>
      <p class="roles-foot">Don’t see your role or industry? <a href={contactLink}>Tell us about it</a></p>
    </section>

    <section class="process">
      <div class="process-content">
        <div class="section-label">Process</div>
        <div class="section-title">How the funnel works</div>
        <ol class="funnel-track">
          <li class="funnel-item" style="--i:0"><span class="funnel-num">01</span><div><h3>Intake call</h3><p>Set the role, team context, and hiring bar.</p></div></li>
          <li class="funnel-item" style="--i:1"><span class="funnel-num">02</span><div><h3>Sourcing</h3><p>Map the market and meet the right people.</p></div></li>
          <li class="funnel-item" style="--i:2"><span class="funnel-num">03</span><div><h3>Screening</h3><p>Check motivation, fit, and the details that matter.</p></div></li>
          <li class="funnel-item" style="--i:3"><span class="funnel-num">04</span><div><h3>Shortlist</h3><p>Meet a focused shortlist with useful context.</p></div></li>
          <li class="funnel-item" style="--i:4"><span class="funnel-num">05</span><div><h3>Interviews</h3><p>Keep interviews and feedback moving.</p></div></li>
          <li class="funnel-item" style="--i:5"><span class="funnel-num">06</span><div><h3>Selection</h3><p>Compare feedback and choose with confidence.</p></div></li>
          <li class="funnel-item" style="--i:6"><span class="funnel-num">07</span><div><h3>Offer</h3><p>Agree terms and support through to the start date.</p></div></li>
        </ol>
      </div>
    </section>
    </div>

    <div class="about-pricing">
    <section class="proof-scroll" data-proof-scroll>
      <div class="proof-scroll-sticky">
        <div class="proof-scroll-heading"><div class="section-label">About us</div><h2>The experience behind every search</h2></div>
        <div class="proof-scroll-viewport">
          <div class="proof-scroll-track">
          <article class="proof-panel" id="proof-panel-record">
            <div class="proof-visual proof-visual-record"><span>14+</span><small>years of technical recruitment<br />and HR leadership</small></div>
            <div class="proof-content record-content"><span class="section-label">Track record</span><h2>Meet the founders</h2><p>The Dreamers Talent was founded by two people who know hiring from both sides of the table. Maryna has spent 14 years finding and closing technical talent, including specialists who never appear on job boards. Her partner has spent 9 years leading delivery teams across FinTech, healthcare, hospitality tech and more, so she knows what a role really needs beyond its title.</p><p>Together, we turn your business goal into a clear brief, find people who truly fit it, and keep everyone honest and aligned, from the first call to the signed offer.</p></div>
          </article>
          <article class="proof-panel" id="proof-panel-values">
            <div class="proof-content"><span class="section-label">What we value</span><h2 class="benefits-title">Recruitment that moves at your pace</h2><ul class="values-list"><li><strong>Impact-driven.</strong> We partner with companies building things that matter: products that move industries forward, protect the planet, improve healthcare, advance robotics, or simply make people’s lives better.</li><li><strong>Purpose over volume.</strong> We build teams for products we believe in: niche, mission-driven companies that make life, work or the planet better.</li><li><strong>Candidates are people, not pipelines.</strong> We build real, lasting relationships with the talent we work with. Respectful communication, timely feedback and honest conversations are non-negotiable on both sides.</li><li><strong>Honesty and realism.</strong> We set clear expectations on salaries, timelines and the market, and help founders hire with realistic expectations from day one.</li></ul></div>
          </article>
          </div>
        </div>
      </div>
    </section>

    <section class="pricing-band" id="pricing">
      <div class="pricing-band-content">
        <div class="section-label">Pricing</div>
        <div class="pricing-band-grid">
          <div><h2>Simple, success-based pricing</h2><p class="pricing-intro">No retainers. No long contracts. You pay only when we deliver the right hire.</p></div>
          <div class="pricing-offer"><span class="pricing-offer-label">Success fee</span><strong>15–20%</strong><p>Of the candidate’s first-year gross salary, charged once they start.</p><ul><li>No upfront payment or retainer</li><li>90-day replacement guarantee</li><li>One role at a time, with volume discounts for 3+ roles</li></ul><a class="pricing-cta" href={bookingLink} target="_blank" rel="noopener noreferrer">Book a call</a></div>
        </div>
      </div>
    </section>

    <section class="company-cta-band">
      <div>
        <span>Your next great hire</span>
        <h2>Hiring for something that matters? Tell us about the role</h2>
      </div>
      <a class="company-cta" href={bookingLink} target="_blank" rel="noopener noreferrer">Book a call <span>↗</span></a>
    </section>
    </div>

  </div><!-- /.wrap -->

  <script>
    document.querySelectorAll('[data-proof-scroll]').forEach((section) => {
      const viewport = section.querySelector('.proof-scroll-viewport');
      const track = section.querySelector('.proof-scroll-track');

      const updateInternalScroll = () => {
        if (window.matchMedia('(max-width: 640px)').matches) {
          track.style.transform = '';
          return;
        }
        const rect = section.getBoundingClientRect();
        const scrollRange = Math.max(section.offsetHeight - window.innerHeight, 1);
        const progress = Math.min(Math.max(-rect.top / scrollRange, 0), 1);
        const travel = Math.max(track.offsetHeight - viewport.offsetHeight, 0);
        const internalProgress = Math.min(Math.max((progress - 0.22) / 0.51, 0), 1);
        track.style.transform = `translateY(-${internalProgress * travel}px)`;
      };

      window.addEventListener('scroll', updateInternalScroll, { passive: true });
      window.addEventListener('resize', updateInternalScroll);
      updateInternalScroll();
    });
  </script>

</Layout>
