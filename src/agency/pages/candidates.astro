---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';

const cvLink = `mailto:${siteConfig.brand.cvEmail}`;
---

<Layout
  title="Startup Roles for Candidates | The Dreamers Talent"
  description="Explore startup and scaleup roles with confidential, direct introductions to founders and hiring managers from The Dreamers Talent."
>

  <div class="candidate-page">
    <section class="candidate-hero">
      <div class="candidate-hero-copy">
        <div class="eyebrow">For candidates</div>
        <h1>Your next role should feel like a move forward</h1>
        <p>We connect thoughtful people directly with founders and hiring managers building something worth joining — quietly, and on your terms.</p>
        <div class="hero-actions">
          <a class="cta" href={cvLink}>Share your CV</a>
        </div>
      </div>
    </section>

    <section class="candidate-promise" aria-label="Our candidate promise">
      <div class="candidate-promise-inner">
        <span class="candidate-promise-label">Candidate promise</span>
        <p>Clear context, honest advice, and introductions that respect your time.</p>
        <ul>
          <li>Private by default</li>
          <li>Founder-level access</li>
          <li>Support through the decision</li>
        </ul>
      </div>
    </section>

    <section class="candidate-cta-band">
      <div>
        <span>Open to the right thing?</span>
        <h2>Let’s make your next move a considered one</h2>
      </div>
      <a class="candidate-cta" href={cvLink}>Share your CV <span>↗</span></a>
    </section>
  </div>

</Layout>
