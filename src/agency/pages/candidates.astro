---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';

const contactLink = `mailto:${siteConfig.brand.email}`;
---

<Layout
  title="Startup Roles for Candidates | The Dreamers Talent"
  description="Explore startup and scaleup roles with confidential, direct introductions to founders and hiring managers from The Dreamers Talent."
>

  <div class="candidate-page">
    <section class="candidate-hero">
      <div class="candidate-hero-copy">
        <div class="eyebrow">For candidates</div>
        <h1>Your next role should feel like a move forward.</h1>
        <p>We connect thoughtful people directly with founders and hiring managers building something worth joining — quietly, and on your terms.</p>
        <div class="hero-actions">
          <a class="cta" href={contactLink}>Share your CV</a>
        </div>
      </div>
      <aside class="candidate-hero-note" aria-label="Our candidate promise">
        <span>Candidate promise</span>
        <p>Clear context, honest advice, and introductions that respect your time.</p>
        <ul>
          <li>Private by default</li>
          <li>Founder-level access</li>
          <li>Support through the decision</li>
        </ul>
      </aside>
    </section>

    <section class="candidate-benefits">
      <div class="candidate-section-heading">
        <div class="section-label">A better search</div>
        <h2>The details that make the difference.</h2>
        <p>We focus on fit, context, and a process that keeps you in control.</p>
      </div>
      <div class="candidate-benefits-grid">
        <article class="candidate-benefit">
          <span class="candidate-benefit-tag">Private by default</span>
          <div class="candidate-benefit-visual candidate-confidential">
            <span class="candidate-benefit-number">01</span>
            <svg class="candidate-benefit-icon" viewBox="0 0 64 64" aria-hidden="true">
              <rect x="19" y="29" width="26" height="20" rx="2" />
              <path d="M25 29v-5a7 7 0 0 1 14 0v5M32 36v6" />
              <circle cx="32" cy="39" r="2" />
              <circle cx="32" cy="32" r="25" />
            </svg>
            <small>YOUR SEARCH, YOUR TERMS</small>
          </div>
          <div class="candidate-benefit-copy">
            <h3>Confidential search</h3>
            <p>Your job search stays private, always. We only introduce you when the opportunity is genuinely right.</p>
          </div>
        </article>
        <article class="candidate-benefit">
          <span class="candidate-benefit-tag">Beyond the job board</span>
          <div class="candidate-benefit-visual candidate-unlisted">
            <span class="candidate-benefit-number">02</span>
            <svg class="candidate-benefit-icon" viewBox="0 0 64 64" aria-hidden="true">
              <rect x="14" y="11" width="36" height="42" rx="2" />
              <path d="M14 22h36M23 31h18M23 39h12" />
              <circle cx="22" cy="17" r="2" />
              <circle cx="29" cy="17" r="2" />
            </svg>
            <small>ROLES WORTH HEARING ABOUT</small>
          </div>
          <div class="candidate-benefit-copy">
            <h3>Unlisted roles</h3>
            <p>Access opportunities before they are posted publicly — often while the brief is still being shaped.</p>
          </div>
        </article>
        <article class="candidate-benefit">
          <span class="candidate-benefit-tag">Context over keywords</span>
          <div class="candidate-benefit-visual candidate-matched">
            <span class="candidate-benefit-number">03</span>
            <svg class="candidate-benefit-icon" viewBox="0 0 64 64" aria-hidden="true">
              <circle cx="25" cy="32" r="15" />
              <circle cx="39" cy="32" r="15" />
              <path d="M28 32h8M32 28v8" />
            </svg>
            <small>STAGE, TEAM, AND AMBITION</small>
          </div>
          <div class="candidate-benefit-copy">
            <h3>Matched to stage</h3>
            <p>We look beyond the title, matching you to the company’s real stage, pace, and culture.</p>
          </div>
        </article>
        <article class="candidate-benefit">
          <span class="candidate-benefit-tag">No ATS black hole</span>
          <div class="candidate-benefit-visual candidate-intro">
            <span class="candidate-benefit-number">04</span>
            <svg class="candidate-benefit-icon" viewBox="0 0 64 64" aria-hidden="true">
              <circle cx="20" cy="22" r="7" />
              <circle cx="44" cy="42" r="7" />
              <path d="M25 27l14 10M13 47c1-9 6-14 14-14M37 33c8 0 13 5 14 14" />
            </svg>
            <small>STRAIGHT TO THE DECISION-MAKER</small>
          </div>
          <div class="candidate-benefit-copy">
            <h3>Direct intro</h3>
            <p>You speak with the hiring manager, not a system. We make the introduction with real context.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="candidate-journey">
      <div class="candidate-section-heading">
        <div class="section-label">The process</div>
        <h2>A clear path, at your pace.</h2>
      </div>
      <ol class="candidate-journey-steps">
        <li><span>01</span><h3>Share your profile</h3><p>A quick introduction or CV gives us the context to start.</p><small>15 minutes</small></li>
        <li><span>02</span><h3>We make the match</h3><p>We bring you relevant openings, with the useful details upfront.</p><small>When there’s a fit</small></li>
        <li><span>03</span><h3>Meet the team</h3><p>A direct, well-briefed conversation with the people making the decision.</p><small>Founder or hiring lead</small></li>
        <li><span>04</span><h3>Move with support</h3><p>We stay close through interviews, feedback, and the final decision.</p><small>All the way through</small></li>
      </ol>
    </section>

    <section class="candidate-cta-band">
      <div>
        <span>Open to the right thing?</span>
        <h2>Let’s make your next move a considered one.</h2>
      </div>
      <a class="candidate-cta" href={contactLink}>Share your CV <span>↗</span></a>
    </section>
  </div>

</Layout>
