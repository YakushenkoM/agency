---
import siteConfig from '../../../site.config.json';

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const basePath = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const canonicalUrl = new URL(basePath, siteUrl).toString();
const socialImageUrl = new URL(`${basePath}social-card.png`, siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="The Dreamers Talent is coming soon. Recruitment for startups and scaleups." />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#F86D22" />
    <title>{siteConfig.brand.name} — Coming soon</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.brand.name} />
    <meta property="og:title" content={`${siteConfig.brand.name} — Coming soon`} />
    <meta property="og:description" content="Recruitment for startups and scaleups. Coming soon." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${siteConfig.brand.name} — Coming soon`} />
    <meta name="twitter:description" content="Recruitment for startups and scaleups. Coming soon." />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Public+Sans:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="coming-soon">
      <div class="frame" aria-hidden="true"></div>
      <div class="content">
        <p class="brand">{siteConfig.brand.name}</p>
        <p class="eyebrow">Recruitment for startups and scaleups</p>
        <h1>Something considered is taking shape.</h1>
        <p class="copy">We’re preparing a sharper, more thoughtful way to build the teams behind ambitious companies.</p>
        <a href={`mailto:${siteConfig.brand.email}`}>Get in touch <span>↗</span></a>
      </div>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #F86D22; color: #F9EDB1; font-family: 'Public Sans', sans-serif; }
  .coming-soon { position: relative; display: grid; min-height: 100svh; place-items: center; overflow: hidden; padding: 42px; background-image: radial-gradient(rgba(249,237,177,.2) 1px, transparent 1px); background-size: 12px 12px; }
  .coming-soon::before, .coming-soon::after { position: absolute; width: min(32vw, 420px); height: min(32vw, 420px); border: 1px solid rgba(249,237,177,.45); border-radius: 50%; content: ''; }
  .coming-soon::before { right: -12vw; top: -12vw; }
  .coming-soon::after { bottom: -16vw; left: -14vw; }
  .frame { position: absolute; inset: clamp(24px, 5vw, 72px); border: 1px solid rgba(249,237,177,.62); pointer-events: none; }
  .content { position: relative; z-index: 1; max-width: 760px; text-align: center; }
  .brand { margin: 0 0 clamp(48px, 10vh, 120px); font-family: 'Fraunces', serif; font-size: clamp(25px, 3vw, 38px); letter-spacing: -.03em; }
  .eyebrow { display: inline-block; margin: 0 0 24px; padding: 8px 12px; border: 1px solid rgba(249,237,177,.62); font-family: 'Space Mono', monospace; font-size: 10px; letter-spacing: .09em; text-transform: uppercase; }
  h1 { max-width: 700px; margin: 0 auto 24px; font-family: 'Fraunces', serif; font-size: clamp(48px, 7vw, 88px); font-weight: 500; letter-spacing: -.06em; line-height: .95; }
  .copy { max-width: 560px; margin: 0 auto 35px; color: rgba(249,237,177,.88); font-size: clamp(16px, 1.5vw, 20px); line-height: 1.55; }
  a { display: inline-flex; gap: 18px; align-items: center; padding: 15px 21px; background: #F9EDB1; color: #F86D22; font-family: 'Space Mono', monospace; font-size: 12px; font-weight: 700; letter-spacing: .05em; text-decoration: none; text-transform: uppercase; transition: transform 150ms ease, opacity 150ms ease; }
  a:hover { opacity: .9; transform: translateY(-2px); }
  a span { font-size: 17px; line-height: .8; }
  @media (max-width: 640px) { .coming-soon { padding: 24px; } .frame { inset: 12px; } .brand { margin-bottom: 64px; } }
</style>
